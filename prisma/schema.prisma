// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lead captures every quote request submitted from any of the 3 mockup
// designs. The `design` field records which mockup the lead came from so
// the client can A/B-test which design converts best.
model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String?
  design    String?
  // Optional estimator snapshot so we can see what price range the user
  // was shown when they submitted (helpful for sales follow-up).
  estimate  String?
  ipHash    String?
  createdAt DateTime @default(now())
}

// DesignFeedback stores per-design review notes left by the client via the
// "Design notes" drawer in the mockup switcher. Used to collect the
// client's preferences before going live with a single design.
model DesignFeedback {
  id        String   @id @default(cuid())
  design    String
  rating    Int?
  notes     String
  createdAt DateTime @default(now())
}